# Copy to `.env.local` for local dev. Never commit `.env.local`.
# All client-side env vars MUST be prefixed VITE_ — non-prefixed vars are NOT exposed to the browser.

# Toggle between MSW mocks (true) and real backend (false). Default: true in dev, false in prod build.
VITE_USE_MOCKS=true

# Base URL for the Spring Boot API. Leave blank when VITE_USE_MOCKS=true.
VITE_API_BASE_URL=

# App branding (used in <title> + chrome). Keep names short.
VITE_APP_NAME=Ghar Se
VITE_APP_TAGLINE=Home makers of Sirsi

# Default city (used for UI copy + delivery scope). Keep lowercase-friendly slug.
VITE_DEFAULT_CITY=Sirsi

# Feature flags — switch experimental UI on/off without redeploying.
VITE_FEATURE_KANNADA_UI=false
VITE_FEATURE_VOICE_ASSIST=false

# Sentry (optional). Leave blank to disable error reporting.
VITE_SENTRY_DSN=
